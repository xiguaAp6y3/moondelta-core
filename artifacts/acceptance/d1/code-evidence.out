  163: ///|
  164: /// 创建一张新的 Delta 表（写入 version 0：commitInfo + protocol + metaData）。
  165: pub fn create_table(
  166:   root : String,
  167:   schema_json : String,
  168:   partition_columns : Array[String],
  169: ) -> Int32 raise DeltaError {
  170:   ensure_dir(root)
  171:   let log = log_dir(root)
  172:   ensure_dir(log)
  173:   let commit_info = "{\"commitInfo\":{\"timestamp\":0,\"operation\":\"CREATE TABLE\",\"operationParameters\":{},\"isolationLevel\":\"Serializable\",\"isBlindAppend\":true,\"engineInfo\":\"moondelta-core\"}}"
  174:   let protocol = "{\"protocol\":{\"minReaderVersion\":1,\"minWriterVersion\":2}}"
  175:   let meta_data = "{\"metaData\":{\"id\":" +
  176:     json_string("moondelta-" + root) +
  177:     ",\"format\":{\"provider\":\"parquet\",\"options\":{}},\"schemaString\":" +
  178:     json_string(schema_json) +
  179:     ",\"partitionColumns\":" +
  180:     json_string_array(partition_columns) +
  181:     ",\"configuration\":{},\"createdTime\":0}}"
  182:   let content = commit_info + "\n" + protocol + "\n" + meta_data + "\n"
  183:   write_text(log + "/" + version_file_name(0), content)
  184:   0
  185: }
