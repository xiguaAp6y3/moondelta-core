----- src/types.mbt : 128-146
  128: ///|
  129: pub(all) suberror DeltaError {
  130:   IoError(String)
  131:   ParseError(String)
  132:   Unsupported(String)
  133:   NotFound(String)
  134: } derive(Eq, Debug)
  135: 
  136: ///|
  137: pub fn describe_error(e : DeltaError) -> String {
  138:   match e {
  139:     IoError(m) => "io error: " + m
  140:     ParseError(m) => "parse error: " + m
  141:     Unsupported(m) => "unsupported: " + m
  142:     NotFound(m) => "not found: " + m
  143:   }
  144: }
