----- src/schema.mbt : 110-132
  110: 
  111: ///|
  112: /// 判断 schema 是否能在当前读取路径上安全读取；不能则给出明确原因。
  113: pub fn ensure_readable_schema(schema : DeltaSchema) -> Unit raise DeltaError {
  114:   for f in schema.fields {
  115:     match f.type_ {
  116:       NestedType(kind~) =>
  117:         raise DeltaError::Unsupported(
  118:           "nested column '\{f.name}' (type=\{kind}) is not supported by the parquet reader; only flat schemas are readable",
  119:         )
  120:       UnknownType(raw~) =>
  121:         raise DeltaError::Unsupported(
  122:           "unsupported delta type '\{raw}' for column '\{f.name}'",
  123:         )
  124:       DecimalType(precision~, scale~) =>
  125:         raise DeltaError::Unsupported(
  126:           "decimal(\{precision},\{scale}) column '\{f.name}' is not supported (logical type is lost by the reader)",
  127:         )
  128:       _ => ()
  129:     }
  130:   }
  131: }
  132: 
----- src/log.mbt : 99-130
  99: pub fn checkpoint_info(root : String) -> CheckpointInfo? raise DeltaError {
  100:   let path = log_dir(root) + "/_last_checkpoint"
  101:   if !@fs.path_exists(path) {
  102:     return None
  103:   }
  104:   let text = read_text(path)
  105:   let j = @json.parse(text) catch { _ => return None }
  106:   let version = match json_field_int(j, "version") {
  107:     Some(v) => v
  108:     None => return None
  109:   }
  110:   let size = json_field_int(j, "size")
  111:   let parts = json_field_int(j, "parts")
  112:   Some({ version, size, parts, })
  113: }
  114: 
  115: ///|
  116: /// 是否存在 checkpoint 文件（`.checkpoint.parquet`）
  117: pub fn has_checkpoint_file(root : String) -> Bool {
  118:   let dir = log_dir(root)
  119:   if !@fs.path_exists(dir) {
  120:     return false
  121:   }
  122:   let names = @fs.read_dir(dir) catch { _ => return false }
  123:   for name in names {
  124:     if name.has_suffix(".checkpoint.parquet") {
  125:       return true
  126:     }
  127:   }
  128:   false
  129: }
